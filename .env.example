# ControlPlane.ai — Environment Configuration
# Copy to .env and adjust values as needed.

# PostgreSQL
DATABASE_URL=postgres://controlplane:secret@localhost:5432/controlplane

# NATS (optional — set EVENT_BUS=nats to use)
NATS_URL=nats://localhost:4222

# Event bus mode: "inproc" (default, no external deps) or "nats"
EVENT_BUS=inproc

# Proxy configuration
PROXY_LISTEN_ADDR=0.0.0.0:8900

# AI Provider — choose one:
#   "ollama" (default, local) | "anthropic" | "gemini"
UPSTREAM_PROVIDER=ollama

# Provider API key (not needed for Ollama; required for cloud providers)
# For Anthropic: get from https://console.anthropic.com/
# For Gemini: get from https://aistudio.google.com/apikey
# UPSTREAM_API_KEY=your-api-key-here

# Model to use
# Ollama default:    qwen2.5:1.5b
# Anthropic default: claude-sonnet-4-20250514
# Gemini default:    gemini-2.0-flash
UPSTREAM_MODEL=qwen2.5:1.5b

# Upstream base URL
# Ollama:    http://localhost:11434 (local) or http://ollama:11434 (Docker)
# Anthropic: https://api.anthropic.com
# Gemini:    https://generativelanguage.googleapis.com
UPSTREAM_BASE_URL=http://localhost:11434

# Guardrails sidecar (Microsoft Presidio + LLM Guard)
# Set to enable PII detection, toxicity, and bias scanning
GUARDRAILS_URL=http://localhost:8200

# Decision-model judge (Laya / Jev) — OPTIONAL, default OFF.
#   off  = shadow path behaves exactly as before (default)
#   laya = self-hosted laya-serve (Jev-compatible POST /v1/systemone), Apache-2.0, free
#   jev  = TypeSafe cloud API (requires TYPESAFE_API_KEY)
# Enabling this only has an effect when the app's policy also sets
# checks.decision_judge_enabled = true. See docs/analysis/laya-integration-plan.md.
DECISION_JUDGE=off
LAYA_URL=http://localhost:8300
LAYA_TIMEOUT_MS=5000
# auto = let Laya's Router pick the checkpoint by language (recommended)
LAYA_MODEL=auto
# LAYA_API_KEY=                 # only if the judge server requires a bearer token
# TYPESAFE_API_KEY=             # only when DECISION_JUDGE=jev
#
# Calibrated fusion thresholds (plan §5.2). These only take effect once a calibration fit
# exists in `detector_calibration` (see scripts/eval_accuracy.sh); without a fit the
# decision engine uses its pre-fusion aggregator and these values are inert.
JUDGE_ESCALATE_THRESHOLD=0.90     # fused p at/above this escalates
JUDGE_EDIT_THRESHOLD=0.70         # fused p at/above this edits
JUDGE_EVIDENCE_THRESHOLD=0.45     # below this a judge reading is discarded, not fused
JUDGE_DISAGREEMENT_DELTA=0.40     # judge-vs-heuristic gap that routes a case to a human

# Dashboard API
DASHBOARD_API_PORT=8080

# Auth
JWT_SECRET=change-me-in-production

# ─── MCP server (services/mcp-server) ─────────────────────────────────────────
# These values drive a *local* (non-Docker) run. docker-compose.yml starts the
# mcp-server as the `mcp-server` service with the HTTP transport on :8090 and
# rewrites the upstream URLs to the in-network service names, so only
# MCP_AUTH_TOKENS / MCP_ALLOW_ANONYMOUS / MCP_ENABLE_INTERNAL_SCANS carry over.
#
# Transport: "stdio" (local MCP clients) or "http" (Streamable HTTP)
MCP_TRANSPORT=stdio
# Upstream endpoints the MCP server calls (defaults match the local stack)
CONTROLPLANE_API_URL=http://localhost:8080
CONTROLPLANE_PROXY_URL=http://localhost:8900
# Optional credential forwarded to the proxy for evaluate_prompt
# CONTROLPLANE_PROXY_API_KEY=
# Static bearer tokens: token:role[:app_id|app_id] (comma separated)
# roles: admin | reviewer | viewer
MCP_AUTH_TOKENS=change-me-admin:admin,change-me-reviewer:reviewer,change-me-viewer:viewer
# Fail closed by default. Set true only for local demos.
MCP_ALLOW_ANONYMOUS=false
# Role used by the stdio transport when MCP_TOKEN is unset
MCP_ROLE=viewer
# Streamable HTTP bind address
MCP_HTTP_ADDR=127.0.0.1:8090
# Limits
MCP_REQUEST_TIMEOUT_MS=15000
MCP_MAX_PAYLOAD_BYTES=262144
MCP_MAX_RESPONSE_BYTES=2097152
MCP_RATE_LIMIT_PER_MIN=120
MCP_RATE_LIMIT_BURST=30
# Internal guardrails sidecar — only used when MCP_ENABLE_INTERNAL_SCANS=true
# CONTROLPLANE_GUARDRAILS_URL=http://localhost:8200
MCP_ENABLE_INTERNAL_SCANS=false

# Logging
LOG_LEVEL=info
RUST_LOG=controlplane=debug,tower_http=debug

# Notification (optional)
SLACK_WEBHOOK_URL=
WEBHOOK_URL=

# Demo
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=Demo#Admin2026

# Frontend (Next.js) — build-time public vars, passed to the `frontend` image
# build by docker-compose.yml. The browser tab title is "RTXCore ControlPlane AI"
# regardless of these; they only choose which hosts the UI calls and displays.
#
# Defaults talk to the published ports directly. To make every request
# same-origin behind the nginx service (which serves the dashboard, /api/ and
# /v1/ on one port-80 origin), point both at the branded name (needs the one-time
# hosts alias, see README Quick Start). Any *.localhost name also works without
# an alias, since nginx answers every host name:
#   NEXT_PUBLIC_API_URL=http://controlplane-ai.rtxcore
#   NEXT_PUBLIC_PROXY_URL=http://controlplane-ai.rtxcore
# Use same-origin mode when another program owns host port 8080.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_PROXY_URL=http://localhost:8900
# MCP server URL shown on Settings → MCP Integration
# NEXT_PUBLIC_MCP_URL=http://localhost:8090

# ─── Docker host ports (docker-compose.yml) ──────────────────────────────────
# All published ports bind to 127.0.0.1. Override a host port when a native
# install already owns it; containers still reach each other on the defaults.
# OLLAMA_HOST_PORT=11434     # native Ollama app uses 11434
# POSTGRES_HOST_PORT=5432    # native PostgreSQL service uses 5432
# API_HOST_PORT=8080         # EDB PEMHTTPD / Homebrew nginx often use 8080
