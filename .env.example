# ControlPlane.ai — Environment Configuration
# Copy to .env and adjust values as needed.

# PostgreSQL
DATABASE_URL=postgres://controlplane:secret@localhost:5432/controlplane

# NATS (optional — set EVENT_BUS=nats to use)
NATS_URL=nats://localhost:4222

# Event bus mode: "inproc" (default, no external deps) or "nats"
EVENT_BUS=inproc

# Proxy configuration
PROXY_LISTEN_ADDR=0.0.0.0:8900

# AI Provider — choose one:
#   "ollama" (default, local) | "anthropic" | "gemini"
UPSTREAM_PROVIDER=ollama

# Provider API key (not needed for Ollama; required for cloud providers)
# For Anthropic: get from https://console.anthropic.com/
# For Gemini: get from https://aistudio.google.com/apikey
# UPSTREAM_API_KEY=your-api-key-here

# Model to use
# Ollama default:    qwen2.5:1.5b
# Anthropic default: claude-sonnet-4-20250514
# Gemini default:    gemini-2.0-flash
UPSTREAM_MODEL=qwen2.5:1.5b

# Upstream base URL
# Ollama:    http://localhost:11434 (local) or http://ollama:11434 (Docker)
# Anthropic: https://api.anthropic.com
# Gemini:    https://generativelanguage.googleapis.com
UPSTREAM_BASE_URL=http://localhost:11434

# Guardrails sidecar (Microsoft Presidio + LLM Guard)
# Set to enable PII detection, toxicity, and bias scanning
GUARDRAILS_URL=http://localhost:8200

# Decision-model judge (Laya / Jev) — OPTIONAL, default OFF.
#   off  = shadow path behaves exactly as before (default)
#   laya = self-hosted laya-serve (Jev-compatible POST /v1/systemone), Apache-2.0, free
#   jev  = TypeSafe cloud API (requires TYPESAFE_API_KEY)
# Enabling this only has an effect when the app's policy also sets
# checks.decision_judge_enabled = true. See docs/analysis/laya-integration-plan.md.
DECISION_JUDGE=off
LAYA_URL=http://localhost:8300
LAYA_TIMEOUT_MS=5000
# auto = let Laya's Router pick the checkpoint by language (recommended)
LAYA_MODEL=auto
# LAYA_API_KEY=                 # only if the judge server requires a bearer token
# TYPESAFE_API_KEY=             # only when DECISION_JUDGE=jev
#
# Calibrated fusion thresholds (plan §5.2). These only take effect once a calibration fit
# exists in `detector_calibration` (see scripts/eval_accuracy.sh); without a fit the
# decision engine uses its pre-fusion aggregator and these values are inert.
JUDGE_ESCALATE_THRESHOLD=0.90     # fused p at/above this escalates
JUDGE_EDIT_THRESHOLD=0.70         # fused p at/above this edits
JUDGE_EVIDENCE_THRESHOLD=0.45     # below this a judge reading is discarded, not fused
JUDGE_DISAGREEMENT_DELTA=0.40     # judge-vs-heuristic gap that routes a case to a human

# Dashboard API
DASHBOARD_API_PORT=8080

# Auth
JWT_SECRET=change-me-in-production

# Logging
LOG_LEVEL=info
RUST_LOG=controlplane=debug,tower_http=debug

# Notification (optional)
SLACK_WEBHOOK_URL=
WEBHOOK_URL=

# Demo
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=Demo#Admin2026
